{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Edit(./.devcontainer/**)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./.claude/settings.json)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(curl:*)"
    ]
  }
}
