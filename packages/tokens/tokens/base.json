{
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": "44px" },
    "mark": { "$value": "28px" },
    "avatar": { "$value": "120px" },
    "figure": { "$value": "28rem" },
    "content": { "$value": "64rem" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": "1px" },
      "focus": { "$value": "2px" },
      "accent": { "$value": "3px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Be Vietnam Pro", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "monospace"]
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.75rem" },
      "2xl": { "$value": "2rem" },
      "3xl": { "$value": "2.75rem" },
      "4xl": { "$value": "3.5rem" },
      "5xl": { "$value": "4.5rem" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.6 }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "250ms" },
      "slow": { "$value": "400ms" },
      "type": { "$value": "1200ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] }
    }
  }
}
