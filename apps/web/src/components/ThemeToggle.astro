---
import { useTranslations, type Locale } from '@mintshell/shared';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button
  type="button"
  class="control theme-toggle"
  aria-label={t('theme.toggle')}
  data-label-to-light={t('theme.toLight')}
  data-label-to-dark={t('theme.toDark')}
>
  {/* Theme tối: hiện mặt trời (bấm để sang sáng); theme sáng: hiện mặt trăng. */}
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    ></path>
  </svg>
</button>

<style>
  /* Không có JavaScript thì nút không hoạt động: theme-init.js gắn data-js, thiếu thì ẩn nút. */
  :global(html:not([data-js])) .theme-toggle {
    display: none;
  }

  svg {
    width: var(--space-5);
    height: var(--space-5);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .icon-moon {
    display: block;
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle';

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    initThemeToggle(button);
  }
</script>
