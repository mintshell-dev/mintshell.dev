---
/**
 * Khối callout trong MDX (ADR 0012): `<Callout type="tldr|critical|insight|note|fix" title?>`.
 * Nhãn song ngữ lấy từ từ điển theo ngôn ngữ của trang; `title` ghi đè nhãn. Màu viền và nhãn
 * theo loại (token), thân dùng `color.text` trên `color.surface` (AA ở cả hai theme, có test).
 */
import { localeFromPath, useTranslations } from '@mintshell/shared';

import { calloutTypes, type CalloutType } from '../../lib/mdx';

interface Props {
  type: CalloutType;
  title?: string;
}

const { type, title } = Astro.props;
if (!calloutTypes.includes(type)) {
  throw new Error(
    `Callout: type không hợp lệ "${String(type)}" (cho phép: ${calloutTypes.join(', ')})`,
  );
}
if (title !== undefined && typeof title !== 'string') {
  throw new Error('Callout: title phải là chuỗi');
}
const t = useTranslations(localeFromPath(Astro.url.pathname));
const label = title?.trim() || t(`callout.${type}`);
---

<div class:list={['callout', `callout--${type}`]} role="note">
  <p class="label">
    <svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {type === 'tldr' && (
        <>
          <polyline points="5,7 10,12 5,17" />
          <line x1="12" y1="17" x2="19" y2="17" />
        </>
      )}
      {type === 'critical' && (
        <>
          <path d="M12 3 L22 20 H2 Z" />
          <line x1="12" y1="9" x2="12" y2="14" />
          <line x1="12" y1="17" x2="12" y2="17.01" />
        </>
      )}
      {type === 'insight' && (
        <>
          <path d="M9 18 H15 M10 21 H14" />
          <path d="M12 3 A6 6 0 0 0 8 13.5 C8.8 14.3 9 15 9 16 H15 C15 15 15.2 14.3 16 13.5 A6 6 0 0 0 12 3 Z" />
        </>
      )}
      {type === 'note' && (
        <>
          <circle cx="12" cy="12" r="9" />
          <line x1="12" y1="11" x2="12" y2="16" />
          <line x1="12" y1="8" x2="12" y2="8.01" />
        </>
      )}
      {type === 'fix' && (
        <path d="M14.7 6.3 A4 4 0 0 0 9.3 11.7 L3 18 L6 21 L12.3 14.7 A4 4 0 0 0 17.7 9.3 L15.2 11.8 L12.8 11.2 L12.2 8.8 Z" />
      )}
    </svg>
    <span>{label}</span>
  </p>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .callout {
    --callout-color: var(--color-accent);
    margin-block: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border-inline-start: var(--border-width-accent) solid var(--callout-color);
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }

  .callout--tldr {
    --callout-color: var(--color-accent);
  }
  .callout--critical {
    --callout-color: var(--severity-critical);
  }
  .callout--insight {
    --callout-color: var(--color-highlight);
  }
  .callout--note {
    --callout-color: var(--severity-low);
  }
  .callout--fix {
    --callout-color: var(--color-muted);
  }

  .label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    color: var(--callout-color);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .icon {
    flex: none;
    width: var(--space-4);
    height: var(--space-4);
  }

  .body > :global(*) {
    margin-block: var(--space-3);
  }

  .body > :global(:first-child) {
    margin-top: 0;
  }

  .body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
