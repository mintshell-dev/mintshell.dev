---
import { localizePath, useTranslations, type Locale } from '@mintshell/shared';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { listWriteups } from '../../lib/writeups';
import WriteupList from '../writeups/WriteupList.astro';

interface Props {
  locale: Locale;
}

/** Số write-up mới nhất hiện ở trang chủ. */
const LATEST = 5;

const { locale } = Astro.props;
const t = useTranslations(locale);
const latest = (await listWriteups(locale)).slice(0, LATEST);
const href = (path: string) => localizePath(path, locale);
---

<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <p class="eyebrow rise">
      <span class="prompt" aria-hidden="true">
        $
      </span>
      {t('home.eyebrow')}
    </p>
    <h1 id="home-title" class="title rise rise-2">
      {t('home.title')}
    </h1>
    <p class="lead rise rise-3">{t('home.intro')}</p>
    <p class="actions rise rise-4">
      <a class="btn btn-primary" href={href('/writeups')}>
        {t('home.ctaWriteups')}
        <span class="arrow" aria-hidden="true">
          {' '}
          →
        </span>
      </a>
      <a class="btn btn-secondary" href={href('/portfolio')}>
        {t('home.ctaPortfolio')}
      </a>
    </p>
  </section>

  <section class="latest reveal" aria-labelledby="home-latest">
    <h2 id="home-latest">
      <span class="slashes" aria-hidden="true">
        //{' '}
      </span>
      {t('home.latest')}
    </h2>
    <WriteupList locale={locale} entries={latest} />
    <p class="more">
      <a href={href('/writeups')}>
        {t('home.allWriteups')}
        <span aria-hidden="true"> →</span>
      </a>
    </p>
  </section>

  <section class="follow reveal" aria-labelledby="home-follow">
    <h2 id="home-follow">
      <span class="slashes" aria-hidden="true">
        //{' '}
      </span>
      {t('home.follow')}
    </h2>
    <ul class="follow-links">
      <li>
        <a href={href('/rss.xml')} type="application/rss+xml">
          {t('home.rss')}
        </a>
      </li>
      <li>
        <a href={href('/search')}>{t('home.search')}</a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-12) var(--space-16);
  }

  .eyebrow {
    display: inline-flex;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .prompt,
  .slashes {
    color: var(--color-accent);
  }

  .title {
    max-width: 20ch;
    margin-block: var(--space-6);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
  }

  @media (min-width: 48rem) {
    .title {
      font-size: var(--font-size-4xl);
    }
  }

  .lead {
    max-width: 60ch;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--font-size-lg);
    line-height: var(--font-line-height-normal);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-8) 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: var(--size-control);
    padding-inline: var(--space-5);
    border: var(--border-width-thin) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition:
      transform var(--motion-duration-fast) var(--motion-easing-out),
      border-color var(--motion-duration-fast);
  }

  .btn-primary {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-secondary {
    color: var(--color-text);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
  }

  .arrow {
    display: inline-block;
    white-space: pre;
    transition: transform var(--motion-duration-fast) var(--motion-easing-out);
  }

  .btn:hover {
    transform: translateY(calc(-1 * var(--space-1)));
  }

  .btn:hover .arrow {
    transform: translateX(var(--space-1));
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .arrow {
      transition: none;
    }

    .btn:hover,
    .btn:hover .arrow {
      transform: none;
    }
  }

  h2 {
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
  }

  .latest,
  .follow {
    padding-block: var(--space-8);
    border-top: var(--border-width-thin) solid var(--color-border);
  }

  .more {
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .follow-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }
</style>
