---
import { useTranslations, type Locale } from '@mintshell/shared';

import type { MarkdownHeading } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  difficultyLabel,
  isoDate,
  platformLabel,
  readingTime,
  slugOf,
  type WriteupEntry,
} from '../../lib/writeups';
import PrevNext from './PrevNext.astro';
import Toc from './Toc.astro';
import '../../styles/prism.css';
import '../../styles/writeup.css';

interface Props {
  locale: Locale;
  entry: WriteupEntry;
  headings: MarkdownHeading[];
  prev: WriteupEntry | undefined;
  next: WriteupEntry | undefined;
}

const { locale, entry, headings, prev, next } = Astro.props;
const t = useTranslations(locale);
const d = entry.data;
// Bản tiếng Anh chưa dịch: không render nội dung, noindex, chỉ dẫn sang bản tiếng Việt.
const pending = locale === 'en' && d.translation === 'pending';
const viHref = `/writeups/${slugOf(entry.id)}`;
const minutes = readingTime(entry);
---

<BaseLayout title={d.title} description={d.description} noindex={pending}>
  {pending ? (
    <section class="pending">
      <h1>{d.title}</h1>
      <p class="notice">{t('writeups.pendingTitle')}</p>
      <p>{t('writeups.pendingBody')}</p>
      <p>
        <a href={viHref}>{t('writeups.pendingLink')} →</a>
      </p>
    </section>
  ) : (
    <article class="writeup">
      <header class="head">
        <h1>{d.title}</h1>
        <p class="description">{d.description}</p>
        <dl class="meta">
          <div>
            <dt>{t('writeups.platform')}</dt>
            <dd>{platformLabel(d.platform, t)}</dd>
          </div>
          <div>
            <dt>{t('writeups.room')}</dt>
            <dd>
              <a href={d.roomUrl} rel="noopener noreferrer">
                {d.room}
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
                <span class="sr-only">{t('a11y.externalLink')}</span>
              </a>
            </dd>
          </div>
          <div>
            <dt>{t('writeups.difficulty')}</dt>
            <dd data-difficulty={d.difficulty}>{difficultyLabel(d.difficulty, t)}</dd>
          </div>
          <div>
            <dt>{t('writeups.vulnClasses')}</dt>
            <dd>{d.vulnClasses.join(', ')}</dd>
          </div>
          <div>
            <dt>
              <time datetime={isoDate(d.date)}>{isoDate(d.date)}</time>
            </dt>
            <dd>
              {minutes} {t('writeups.readingTime')}
            </dd>
          </div>
          {d.updated && (
            <div>
              <dt>{t('writeups.updated')}</dt>
              <dd>
                <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time>
              </dd>
            </div>
          )}
        </dl>
      </header>

      <Toc locale={locale} headings={headings} />

      <div
        class="prose"
        data-copy-code
        data-label-copy={t('code.copy')}
        data-label-copied={t('code.copied')}
      >
        <slot />
      </div>

      <PrevNext locale={locale} prev={prev} next={next} />
    </article>
  )}
  {/* File tĩnh trong public/; is:inline chỉ để Astro không bundle, vẫn là script NGOÀI có src (CSP 'self'). */}
  {!pending && <script is:inline src="/copy-code.js"></script>}
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-mono);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
    margin: 0 0 var(--space-3);
  }

  .description {
    color: var(--color-muted);
    font-size: var(--font-size-lg);
    margin: 0 0 var(--space-6);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-8);
    padding: var(--space-4) 0;
    border-block: var(--border-width-thin) solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  dd {
    margin: 0;
    color: var(--color-text);
  }

  dd[data-difficulty='easy'] {
    color: var(--severity-low);
  }
  dd[data-difficulty='medium'] {
    color: var(--severity-medium);
  }
  dd[data-difficulty='hard'] {
    color: var(--severity-high);
  }
  dd[data-difficulty='insane'] {
    color: var(--severity-critical);
  }

  .arrow {
    font-family: var(--font-mono);
  }

  .pending .notice {
    color: var(--color-highlight);
    font-family: var(--font-mono);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
