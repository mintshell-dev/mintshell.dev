---
import {
  localeFromPath,
  localizePath,
  locales,
  useTranslations,
  type Locale,
} from '@mintshell/shared';

import { tokens } from '@mintshell/tokens';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { OG_HEIGHT, OG_WIDTH } from '../lib/og/cache';
import { xDefault } from '../lib/seo';
import { DEFAULT_OG_IMAGE, isoDate } from '../lib/writeups';
import '../styles/global.css';

interface Props {
  /** Tiêu đề trang; bỏ trống ở trang chủ. */
  title?: string;
  description?: string;
  /** Trang không được index (404). */
  noindex?: boolean;
  /** Ảnh Open Graph (đường dẫn cùng origin); mặc định ảnh chung của site (ADR 0012). */
  ogImage?: string | undefined;
  /** Mô tả ảnh OG; mặc định theo từ điển. */
  ogImageAlt?: string | undefined;
  /** Bản ngôn ngữ có thật của trang (hreflang); mặc định đủ mọi ngôn ngữ. Write-up chỉ có en thì chỉ `['en']` (ADR 0015). */
  alternates?: readonly Locale[] | undefined;
  /**
   * Có thì `og:type=article`. Thời gian chỉ ghi ngày `YYYY-MM-DD` (ISO 8601 hợp lệ cho OGP): không lộ giờ viết bài
   * nếu sau này frontmatter có giờ (review M6a-2 L6).
   * Kèm `article:*` (trang write-up); không có thì `website` (ADR 0015).
   */
  article?:
    { publishedTime: Date; modifiedTime?: Date | undefined; tags: readonly string[] } | undefined;
}

const {
  title,
  description,
  noindex = false,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  alternates = locales,
  article,
} = Astro.props;
const path = Astro.url.pathname;
const locale: Locale = localeFromPath(path);
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://mintshell.dev');
const absolute = (target: Locale) => new URL(localizePath(path, target), site).href;
if (!alternates.includes(locale))
  throw new Error(`alternates phải có ngôn ngữ của chính trang (${locale}): ${path}`);
const hreflangs = locales.filter((l) => alternates.includes(l));
const fullTitle = title ? `${title} — mintshell` : 'mintshell';
const metaDescription = description ?? t('site.description');
const ogLocale: Record<Locale, string> = { vi: 'vi_VN', en: 'en_US' };
// Màu thanh trình duyệt: nền theme tối (theme mặc định), lấy từ token, không ghi cứng.
const themeColor = tokens.theme.dark.color.bg;
// og:image phải là URL tuyệt đối; luôn cùng origin với site, không nhận URL ngoài.
const ogImageUrl = new URL(ogImage, site);
if (ogImageUrl.origin !== new URL(site).origin)
  throw new Error(`ogImage phải cùng origin: ${ogImage}`);
const imageAlt = ogImageAlt ?? t('og.defaultAlt');
// Feed RSS cùng ngôn ngữ với trang (ADR 0010); không có hreflang nên tách khỏi cặp alternate SEO.
const feedHref = new URL(localizePath('/rss.xml', locale), site).href;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* File tĩnh trong public/, chặn render để đặt data-theme trước khi vẽ; is:inline chỉ để Astro không bundle, không phải script nội tuyến. */}
    <script is:inline src="/theme-init.js"></script>
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} />
    <link rel="alternate" type="application/rss+xml" title={t('feed.title')} href={feedHref} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="description" content={metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={absolute(locale)} />
        {hreflangs.map((l) => (
          <link rel="alternate" hreflang={l} href={absolute(l)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(xDefault(hreflangs))} />
        <meta property="og:url" content={absolute(locale)} />
      </>
    )}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={isoDate(article.publishedTime)} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={isoDate(article.modifiedTime)} />
        )}
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta property="og:site_name" content="mintshell" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('skipLink')}
    </a>
    {/* Trang 404 được phục vụ ở mọi URL lạ: nút đổi ngôn ngữ trỏ về trang chủ. */}
    <Header locale={locale} path={noindex ? '/' : path} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
