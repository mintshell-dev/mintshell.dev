---
import { useTranslations } from '@mintshell/shared';

import WriteupList from '../components/writeups/WriteupList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listWriteups } from '../lib/writeups';

const t = useTranslations('vi');
const entries = await listWriteups('vi');
---

<BaseLayout title={t('nav.writeups')}>
  <h1>{t('nav.writeups')}</h1>
  <WriteupList locale="vi" entries={entries} />
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-mono);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-8);
  }
</style>
